{
  "name": "AI-ML Training Labs",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/terraform:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "make bootstrap",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker", "redhat.vscode-yaml", "ms-kubernetes-tools.vscode-kubernetes-tools"],
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python" }
    }
  }
}
